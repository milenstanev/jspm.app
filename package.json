{
  "name": "milenstanev-jspm.angular.template",
  "version": "0.0.1",
  "description": "",
  "registry": "github",
  "repository": "https://github.com/milenstanev/jspm.angular.template.git",
  "main": "dist",
  "scripts": {
    "test": "node scripts/test.js",
    "test:e2e": "playwright test",
    "test:all": "node scripts/test.js && playwright test",
    "postinstall": "node node_modules/jspm/jspm.js install -y && node scripts/ensure-feature-module-paths.js && node scripts/patch-lazyload-router.js",
    "docker-compose": "docker-compose up --build --force",
    "docker-start": "docker-compose start",
    "docker-stop": "docker-compose stop",
    "bash": "docker-compose exec jspm.angular.app bash",
    "start:dev": "gulp dev && node ./util/start.js",
    "start:dev:node": "node node_modules/gulp/bin/gulp.js dev && node ./util/start.js",
    "start:prod": "gulp prod && node ./util/start.js",
    "start:prod:node": "node node_modules/gulp/bin/gulp.js prod && node ./util/start.js",
    "build:prod": "node node_modules/gulp/bin/gulp.js prod",
    "build:vercel": "node scripts/build-vercel.js",
    "deploy:vercel": "npx vercel deploy --prod --yes",
    "serve:prod": "node node_modules/gulp/bin/gulp.js prod && node node_modules/serve/build/main.js . -s -l 3000 -n --no-port-switching",
    "build": "node ./util/dist.js app .",
    "jspm-link": "node node_modules/jspm/jspm.js link -y",
    "jspm-update": "node node_modules/jspm/jspm.js update && node node_modules/jspm/jspm.js clean",
    "jspm-unbundle": "node node_modules/jspm/jspm.js unbundle",
    "jspm-bundle": "node node_modules/gulp/bin/gulp.js prod"
  },
  "author": "Milen Stanev <milen.stanev@gmail.com>",
  "license": "ISC",
  "engines": {
    "node": "20.x"
  },
  "jspm": {
    "dependencies": {
      "angular-core": "milenstanev/mstanev.angular.1.x.x.core@0.0.5",
      "css": "systemjs/plugin-css@^0.1.36",
      "featureRoutes": "milenstanev/jspm.angular.lazyload-router@master",
      "immutable": "npm:immutable@^3.8.1",
      "json": "systemjs/plugin-json@^0.3.0",
      "testModule": "milenstanev/jspm.angular.test-module@master",
      "text": "systemjs/plugin-text@^0.0.11"
    },
    "devDependencies": {
      "babel": "npm:babel-core@^5.8.24",
      "babel-plugin-transform-decorators-legacy": "npm:babel-plugin-transform-decorators-legacy@^1.3.4",
      "babel-preset-es2017": "npm:babel-preset-es2017@^6.24.1",
      "babel-runtime": "npm:babel-runtime@^5.8.24",
      "core-js": "npm:core-js@^1.1.4",
      "plugin-babel": "npm:systemjs-plugin-babel@^0.0.25",
      "plugin-babel-runtime": "npm:babel-runtime@^5.8.24"
    },
    "overrides": {}
  },
  "overrides": {
    "graceful-fs": "^4.2.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "browser-sync": "^3.0.4",
    "connect-history-api-fallback": "^2.0.0",
    "eslint": "^8.57.0",
    "gulp": "^4.0.2",
    "gulp-strip-comments": "^2.5.2",
    "jspm": "^0.16.53",
    "serve": "^14.2.6",
    "through2": "^4.0.2",
    "vercel": "^62.5.0"
  }
}
